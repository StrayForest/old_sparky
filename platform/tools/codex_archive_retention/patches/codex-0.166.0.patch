+            HistoryPosition {
+                thread_id: target_id,
+                end_ordinal_exclusive: 1,
+                end_byte_offset: target_size,
+            },
+        );
+
+        let error = store
+            .delete_archived_threads(crate::DeleteThreadsParams {
+                thread_ids: vec![target_id],
+            })
+            .await
+            .expect_err("active shared history reference must block deletion");
+
+        assert!(error.to_string().contains("forked history still references it"));
+        assert!(archived_path.exists());
+        assert!(source_path.exists());
+    }
