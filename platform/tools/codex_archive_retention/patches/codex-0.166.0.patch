+async fn ensure_archived_targets(
+    store: &LocalThreadStore,
+    thread_ids: &[ThreadId],
+) -> ThreadStoreResult<HashMap<ThreadId, Option<PathBuf>>> {
+    let archive_root = store
+        .config
+        .codex_home
+        .join(ARCHIVED_SESSIONS_SUBDIR)
+        .canonicalize()
+        .map_err(|_| archived_only_error("archive directory is missing or invalid"))?;
+
+    let mut archived_metadata_rollout_paths = HashMap::new();
+    for &thread_id in thread_ids {
+        let Some(state_db) = store.state_db.as_ref() else {
+            return Err(archived_only_error("state database is unavailable"));
+        };
+        let archived_flag = state_db
+            .get_thread_archived_flag(thread_id)
+            .await
+            .map_err(|_| archived_only_error("thread archive flag could not be read"))?;
+        if archived_flag != Some(true) {
+            return Err(archived_only_error("thread archive flag is not set"));
+        }
+        let Some(metadata) = read_sqlite_metadata(store, thread_id).await else {
+            return Err(archived_only_error("thread metadata row is missing"));
+        };
+        if metadata.id != thread_id || metadata.archived_at.is_none() {
+            return Err(archived_only_error("thread is not durably archived"));
+        }
+        let metadata_path = if metadata.rollout_path.is_absolute() {
+            metadata.rollout_path
+        } else {
+            store.config.codex_home.join(metadata.rollout_path)
+        };
+        if !rollout_path_is_archived(store.config.codex_home.as_path(), &metadata_path) {
+            return Err(archived_only_error("thread metadata points outside the archive"));
+        }
+        let Some(rollout_path) =
+            codex_rollout::existing_rollout_path(metadata_path.as_path()).await
+        else {
+            let parent = metadata_path
+                .parent()
+                .ok_or_else(|| archived_only_error("archived rollout path has no parent"))?
+                .canonicalize()
+                .map_err(|_| archived_only_error("archived rollout directory is invalid"))?;
+            if !parent.starts_with(&archive_root)
+                || codex_rollout::thread_id_from_rollout_path(metadata_path.as_path())
+                    != Some(thread_id)
+            {
+                return Err(archived_only_error("missing archived rollout identity does not match"));
+            }
+            for possible_path in [
+                metadata_path.clone(),
+                PathBuf::from(format!("{}.zst", metadata_path.display())),
+            ] {
+                match std::fs::symlink_metadata(possible_path.as_path()) {
+                    Ok(_) => {
+                        return Err(archived_only_error(
+                            "archived rollout exists but could not be resolved",
+                        ));
+                    }
+                    Err(err) if err.kind() == ErrorKind::NotFound => {}
+                    Err(_) => {
+                        return Err(archived_only_error("archived rollout metadata is unreadable"));
+                    }
+                }
+            }
+            archived_metadata_rollout_paths.insert(thread_id, None);
+            continue;
+        };
+        let file_type = std::fs::symlink_metadata(rollout_path.as_path())
+            .map_err(|_| archived_only_error("archived rollout file is missing"))?;
+        if !file_type.file_type().is_file() {
+            return Err(archived_only_error("archived rollout is not a regular file"));
+        }
+        let canonical_path = rollout_path
+            .canonicalize()
+            .map_err(|_| archived_only_error("archived rollout path is invalid"))?;
+        if !canonical_path.starts_with(&archive_root)
+            || codex_rollout::thread_id_from_rollout_path(&canonical_path) != Some(thread_id)
+        {
+            return Err(archived_only_error("archived rollout identity does not match"));
+        }
+        archived_metadata_rollout_paths.insert(thread_id, Some(canonical_path));
+    }
+    Ok(archived_metadata_rollout_paths)
+}
+
+async fn ensure_indexed_rollouts_archived(
+    store: &LocalThreadStore,
+    thread_rollouts: &[ThreadRollouts],
+    archived_metadata_rollout_paths: &HashMap<ThreadId, Option<PathBuf>>,
+) -> ThreadStoreResult<()> {
+    let archive_root = store
+        .config
+        .codex_home
+        .join(ARCHIVED_SESSIONS_SUBDIR)
+        .canonicalize()
+        .map_err(|_| archived_only_error("archive directory is missing or invalid"))?;
+    for thread_rollout in thread_rollouts {
+        if thread_rollout.paths.is_empty() {
+            if matches!(
+                archived_metadata_rollout_paths.get(&thread_rollout.thread_id),
+                Some(None)
+            ) {
+                continue;
+            }
+            return Err(archived_only_error("thread has no indexed archived rollout"));
+        }
+        for path in &thread_rollout.paths {
+            let file_type = std::fs::symlink_metadata(path)
+                .map_err(|_| archived_only_error("indexed rollout file is missing"))?;
+            if !file_type.file_type().is_file() {
+                return Err(archived_only_error("indexed rollout is not a regular file"));
+            }
+            let canonical_path = path
+                .canonicalize()
+                .map_err(|_| archived_only_error("indexed rollout path is invalid"))?;
+            if !canonical_path.starts_with(&archive_root)
+                || codex_rollout::thread_id_from_rollout_path(&canonical_path)
+                    != Some(thread_rollout.thread_id)
+            {
+                return Err(archived_only_error("indexed rollout is outside the archive"));
+            }
+        }
+        if let Some(Some(expected_path)) =
+            archived_metadata_rollout_paths.get(&thread_rollout.thread_id)
+            && !thread_rollout.paths.iter().any(|path| {
+                path.canonicalize()
+                    .is_ok_and(|indexed_path| indexed_path == *expected_path)
+            })
+        {
+            return Err(archived_only_error(
+                "metadata rollout is not indexed for its thread ID",
+            ));
+        }
+    }
+    Ok(())
+}
+
+fn archived_only_error(message: &str) -> ThreadStoreError {
+    ThreadStoreError::InvalidRequest {
+        message: format!("archived-only deletion refused: {message}"),
+    }
+}
+
