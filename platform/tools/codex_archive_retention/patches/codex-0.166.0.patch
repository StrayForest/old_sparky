+    #[tokio::test]
+    async fn archived_only_delete_refuses_unarchive_winning_the_lifecycle_lock() {
+        let home = TempDir::new().expect("temp dir");
+        let (store, runtime, thread_id, active_path, archived_path) =
+            archived_thread_fixture(&home, 333).await;
+        let config = store.config.clone();
+        let delete_store = LocalThreadStore::new(config.clone(), Some(runtime.clone()));
+        let unarchive_store = LocalThreadStore::new(config, Some(runtime.clone()));
+        let barrier = Arc::new(Barrier::new(3));
+        let delete_barrier = Arc::clone(&barrier);
+        let delete = tokio::spawn(async move {
+            delete_barrier.wait().await;
+            delete_store
+                .delete_archived_threads(crate::DeleteThreadsParams {
+                    thread_ids: vec![thread_id],
+                })
+                .await
+        });
+        let unarchive_barrier = Arc::clone(&barrier);
+        let unarchive = tokio::spawn(async move {
+            unarchive_barrier.wait().await;
+            unarchive_store
+                .unarchive_thread(crate::ArchiveThreadParams { thread_id })
+                .await
+        });
+        barrier.wait().await;
+        let delete_result = delete.await.expect("delete task");
+        let unarchive_result = unarchive.await.expect("unarchive task");
+
+        match (delete_result, unarchive_result) {
+            (Ok(()), Err(_)) => {
+                assert!(!archived_path.exists());
+                assert!(!active_path.exists());
+                assert!(runtime
+                    .get_thread(thread_id)
+                    .await
+                    .expect("read deleted metadata")
+                    .is_none());
+            }
+            (Err(_), Ok(_)) => {
+                assert!(archived_path.exists() ^ active_path.exists());
+                assert!(active_path.exists());
+                let metadata = runtime
+                    .get_thread(thread_id)
+                    .await
+                    .expect("read restored metadata")
+                    .expect("thread row remains");
+                assert!(metadata.archived_at.is_none());
+            }
+            (Err(_), Err(_)) => {
+                assert!(archived_path.exists());
+                assert!(!active_path.exists());
+                let metadata = runtime
+                    .get_thread(thread_id)
+                    .await
+                    .expect("read retained metadata")
+                    .expect("thread row remains");
+                assert!(metadata.archived_at.is_some());
+            }
+            (Ok(()), Ok(_)) => panic!("unarchive and archived-only delete both succeeded"),
+        }
+    }
