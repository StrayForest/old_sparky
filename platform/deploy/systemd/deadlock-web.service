[Unit]
Description=Old Sparky Arena Web
After=network-online.target deadlock-api.service
Wants=network-online.target
StartLimitIntervalSec=300s
StartLimitBurst=5

[Service]
Type=simple
User=oldsparky-web
Group=oldsparky-web
WorkingDirectory=/opt/oldsparky/platform/current
Environment=NODE_ENV=production
Environment=PLATFORM_RUNTIME_SERVICE=web
Environment=PLATFORM_SHARED_DIR=/opt/oldsparky/platform/shared
Environment=PLATFORM_ENV_FILE=/opt/oldsparky/platform/shared/env/web.env
Environment=PLATFORM_NODE_BIN=/opt/oldsparky/platform/shared/node-v26.3.1/bin/node
LogRateLimitIntervalSec=30s
LogRateLimitBurst=2000
ExecStart=/opt/oldsparky/platform/current/tools/platform_run_web.sh
# Keep the graceful 143 status for explicit manager stops, while Restart=always
# also recovers an unexpected clean SIGTERM. systemd suppresses Restart for an
# explicit stop job, so release/recovery stop semantics remain unchanged.
SuccessExitStatus=143
Restart=always
# Five starts in five minutes bounds a persistent crash without hiding a
# transient clean exit behind an inactive public service.
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/opt/oldsparky/platform/current/apps/platform_web/.next/standalone/.next/cache
TasksMax=128
MemoryMax=1G

[Install]
WantedBy=multi-user.target
